rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function miUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return autenticado() && miUsuario().rol == 'admin';
    }

    // Alcance del admin: los inmuebles que administra, expandidos HACIA ABAJO
    // por las Functions. Vacío = admin GLOBAL (el dueño), que es como se
    // comportaba todo antes de que existieran los admins por edificio.
    function alcanceAdmin() {
      return miUsuario().get('administraIds', []);
    }

    function esAdminGlobal() {
      return esAdmin() && alcanceAdmin().size() == 0;
    }

    // Los inmuebles que alcanza el vecino: la cadena YA EXPANDIDA que escriben
    // las Functions (su inmueble asignado más los ancestros). Se guarda plana a
    // propósito: aquí no se puede recorrer una lista de mapas ni subir un árbol.
    function misInmuebles() {
      return miUsuario().get('inmueblesIds', []);
    }

    // Acceso a un dispositivo: propio (permanente), heredado del inmueble donde
    // está, o por un pase no vencido.
    function tieneAcceso(id) {
      let u = miUsuario();
      return id in u.get('dispositivos', [])
        // Un acceso temporal vale si YA empezó y todavía no venció. `desde`
        // puede no estar (accesos de antes de los pases programados): sin él,
        // vale desde siempre.
        || (id in u.get('accesos', {})
            && u.accesos[id].expira > request.time
            && u.accesos[id].get('desde', request.time) <= request.time)
        || (resource.data.get('inmueble', '') != ''
            && resource.data.inmueble in u.get('inmueblesIds', []));
    }

    // Cada vecino solo puede leer su propio perfil; el admin puede leer todos.
    // Nadie escribe desde la app: los perfiles los administran las Functions
    // (creación por el admin y canje de pases) o la consola de Firebase.
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esAdminGlobal()
        || (esAdmin() && resource.data.get('inmueblesIds', []).hasAny(alcanceAdmin())));
      // El admin de edificio tiene que traer la consulta filtrada por sus
      // inmuebles (array-contains-any): la regla se evalúa por documento, así
      // que si cae uno de otro edificio falla la consulta entera.
      allow list: if esAdminGlobal()
        || (esAdmin() && resource.data.get('inmueblesIds', []).hasAny(alcanceAdmin()));
      allow write: if false;
    }

    // Un vecino solo puede leer los dispositivos que tiene asignados, los del
    // inmueble que le corresponde, o los compartidos por un pase vigente.
    match /dispositivos/{id} {
      // ⚠️ El admin de un edificio NO alcanza lo privado de sus vecinos.
      // Administrar un edificio es mandar en sus puertas y sus luces comunes,
      // no en la lámpara del salón de alguien. `dueno` vacío = del condominio;
      // con dueño = de un vecino, y entonces solo lo ve él (por `tieneAcceso`)
      // y el dueño global. Es el mismo criterio de `seRegistra()`, que tampoco
      // anota lo de un vecino en el registro del condominio.
      //
      // `dueno` DIRECTO y no `get('dueno', '')`: para que una consulta con
      // `where('dueno','==','')` sea demostrablemente segura, la regla tiene que
      // mirar el campo. Por eso el 8 de agosto de 2026 se rellenó con cadena
      // vacía en los 11 dispositivos que no lo traían — un campo ausente no
      // coincide con una igualdad, y sin eso desaparecían de la lista.
      allow get: if autenticado() && (esAdminGlobal() || tieneAcceso(id)
        || (esAdmin() && resource.data.get('inmueble', '') in alcanceAdmin()
            && resource.data.get('dueno', '') == ''));
      // El vecino necesita LISTAR para traerse de una los de su inmueble (antes
      // solo podía pedirlos de uno en uno, porque los tenía enumerados). La
      // regla se evalúa contra cada documento devuelto, así que la consulta
      // tiene que venir filtrada por inmueble: si trae uno de otro edificio,
      // falla entera.
      allow list: if esAdminGlobal()
        || (esAdmin() && resource.data.inmueble in alcanceAdmin()
            && resource.data.dueno == '')
        || (autenticado() && resource.data.get('inmueble', '') != ''
            && resource.data.inmueble in misInmuebles());
      allow write: if false;

      // Config Tuya: las Functions la leen con Admin SDK; el admin puede
      // verla para editarla desde el panel. Nadie escribe desde el cliente.
      match /privado/{doc} {
        allow read: if esAdminGlobal()
          || (esAdmin()
              && get(/databases/$(database)/documents/dispositivos/$(id)).data.get('inmueble', '') in alcanceAdmin()
              && get(/databases/$(database)/documents/dispositivos/$(id)).data.get('dueno', '') == '');
        allow write: if false;
      }
    }

    // Pases: los crea/canjea/revoca las Functions. El emisor (o el admin)
    // puede leer los suyos para listarlos y revocarlos.
    match /pases/{token} {
      allow read: if autenticado() && (esAdminGlobal() || resource.data.por == request.auth.uid);
      allow write: if false;
    }

    // El log de auditoría lo escriben las Cloud Functions y lo lee solo el admin.
    // Historial de actividad. El documento dice QUÉ pasó y DÓNDE, nunca quién:
    // el admin de un edificio puede ver la actividad de su torre, pero la
    // identidad del vecino vive en el subdocumento `privado/quien` y es solo
    // del dueño. Se separó porque las reglas no pueden ocultar campos.
    match /registros/{id} {
      allow get: if esAdminGlobal()
        || (esAdmin() && resource.data.get('inmueble', '') in alcanceAdmin());
      // El admin de edificio tiene que filtrar por sus inmuebles: la regla se
      // evalúa por documento y si cae uno de otro edificio falla la consulta.
      allow list: if esAdminGlobal()
        || (esAdmin() && resource.data.get('inmueble', '') in alcanceAdmin());
      allow write: if false;

      // Quién lo hizo: dato privado de la app, solo el dueño.
      match /privado/{doc} {
        allow read: if esAdminGlobal();
        allow write: if false;
      }
    }

    // Catálogo de inmuebles del condominio. Lo crean, editan y asignan las
    // Functions (solo admin). Cualquier autenticado puede leerlo (lo usará el
    // selector de "Mi perfil" cuando se habilite la autoasignación).
    // Los inmuebles NO son públicos entre condominios.
    //
    // Decía `if autenticado()`, así que cualquiera con cuenta se traía el
    // catálogo de todos: los edificios de gente que no conoce, con sus nombres
    // y su ciudad. Se vio probando con un admin de edificio, que además tenía
    // esos inmuebles a mano para asignárselos a un vecino.
    //
    // Se lee lo propio (la cadena `inmueblesIds` ya trae los ancestros, que es
    // lo que permite pintar la ruta completa) y lo que se administra. El dueño
    // global, todo.
    //
    // ⚠️ Regla POR DOCUMENTO: la app no puede pedir la colección entera. Pide
    // por `documentId() in [...]` con los ids que le tocan; un `getDocs` sin
    // `where` vuelve a fallar entero, igual que en `skins`.
    match /inmuebles/{id} {
      allow read: if esAdminGlobal()
        || (autenticado() && id in miUsuario().get('inmueblesIds', []))
        || (esAdmin() && id in alcanceAdmin());
      allow write: if false;
    }

    // Galería de skins: los crea cualquier vecino desde el Locker (vía
    // Functions, que es donde se genera y se valida la imagen). La imagen viaja
    // dentro del documento como data URI.
    //
    // Se lee lo PÚBLICO —lo que el admin aprobó— más lo propio, que nace privado
    // y solo ve su autor. Ojo: esto es una regla POR DOCUMENTO, y las reglas no
    // filtran consultas, así que la app NO puede pedir la colección entera; pide
    // dos consultas (`publico == true` y `autor == mi uid`) y las junta. Si algún
    // día alguien vuelve a poner un `getDocs` sin `where`, falla entero.
    match /skins/{id} {
      allow read: if autenticado() && (
        resource.data.get('publico', false) == true
        || resource.data.get('autor', '') == request.auth.uid
        || esAdmin()
      );
      allow write: if false;
    }

    // Historial de conexión: un tramo cerrado por cada cambio de estado, con su
    // duración. Lo escriben las Functions. Lo lee el dueño, y el admin de un
    // edificio solo lo de sus inmuebles (mismo criterio que el registro: la
    // consulta tiene que venir filtrada o la regla la rechaza entera).
    match /conexiones/{id} {
      allow read: if esAdminGlobal()
        || (esAdmin() && resource.data.get('inmueble', '') in alcanceAdmin());
      allow write: if false;
    }

    // Tokens de Tuya de cada vecino (OAuth). NADIE los lee desde el cliente:
    // con uno de estos se controlan sus dispositivos. Solo las Functions.
    match /tuyaAuth/{uid} {
      allow read, write: if false;
    }

    // Marca de tiempo del último correo de "olvidé mi clave" por cuenta, para
    // limitar los envíos. Solo lo tocan las Functions; nadie más lo lee, porque
    // delataría qué correos tienen cuenta.
    match /resets/{id} {
      allow read, write: if false;
    }
  }
}
